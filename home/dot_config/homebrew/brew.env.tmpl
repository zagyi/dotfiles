# See https://docs.brew.sh/Manpage#environment

# Homebrew
#HOMEBREW_ALLOWED_TAPS="..."
HOMEBREW_CACHE={{ .xdgCache }}/Homebrew
HOMEBREW_COLOR=1
HOMEBREW_CURLRC={{ .xdgConfig }}/curlrc
HOMEBREW_LOGS={{ .xdgState }}/Homebrew/Logs
HOMEBREW_NO_ANALYTICS=1
HOMEBREW_NO_ENV_HINTS=1
HOMEBREW_REQUIRE_TAP_TRUST=1
HOMEBREW_UPGRADE_GREEDY=1
HOMEBREW_VERIFY_ATTESTATIONS=1

# https://stdout.no/posts/hardening-homebrew-config/
HOMEBREW_SYSTEM_ENV_TAKES_PRIORITY=1
HOMEBREW_NO_INSECURE_REDIRECT=1

# Homebrew Bundle
HOMEBREW_BUNDLE_USER_CACHE={{ .xdgCache }}/Homebrew/bundler_cache # See https://github.com/Homebrew/brew/pull/17327
HOMEBREW_BUNDLE_INSTALL_CLEANUP=1

HOMEBREW_GITHUB_API_TOKEN={{ keyring "HOMEBREW_GITHUB_API_TOKEN" .chezmoi.username }}
